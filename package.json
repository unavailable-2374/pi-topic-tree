{
	"name": "pi-topic-tree",
	"version": "0.2.0",
	"description": "Topic-tree memory for the Pi coding agent: classifies turns into topic branches, sends the model a small projection of the conversation, and recalls anything older on demand.",
	"type": "module",
	"license": "MIT",
	"keywords": ["pi-package", "pi-extension", "context", "memory"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/unavailable-2374/pi-topic-tree.git"
	},
	"files": ["src", "README.md", "BENCHMARKS.md", "LICENSE"],
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^0.87.1",
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^22.0.0",
		"typebox": "1.3.27",
		"typescript": "^5.9.0",
		"vitest": "4.1.11"
	}
}
